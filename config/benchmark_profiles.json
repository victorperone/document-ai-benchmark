        "auto": {
          "method": "auto",
          "ocr_enabled": true
        },
        "ocr": {
          "method": "ocr",
          "ocr_enabled": true
        }
      }
    },
    "paddleocr": {
      "profiles": {
        "lightweight": {
          "ocr_enabled": true,
          "table_recognition": true,
          "formula_recognition": false,
          "chart_recognition": false,
          "document_orientation_classification": false,
          "textline_orientation": false,
          "document_unwarping": false,
          "region_detection": true,
          "seal_recognition": false
        },
