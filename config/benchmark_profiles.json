{
  "schema_version": 2,
  "benchmark": {
    "reference_tokenizer": "o200k_base",
    "input_directory": "data/raw/batch",
    "input_glob": "*.pdf",
    "output_directory": "outputs",
    "execution_mode": "sequential"
  },
  "normalization": {
    "header_footer_cleanup": true,
    "minimum_repeated_page_fraction": 0.3,
    "minimum_repeated_page_count": 3,
    "short_line_character_threshold": 20,
    "keep_removed_content_audit": true,
    "header_candidate_lines": 3,
    "footer_candidate_lines": 3,
    "normalize_page_numbers": true,
    "trim_page_outer_whitespace": true
  },
  "parsers": {
    "pymupdf": {
      "profiles": {
        "native": {
          "ocr_enabled": false,
          "ocr_mode": "disabled",
          "ocr_engine": null,
          "ocr_language": null,
          "ocr_dpi": null,
          "layout_module": true,
          "parser_header": true,
          "parser_footer": true,
          "force_text": true,
          "write_images": false,
          "embed_images": false,
          "page_separators": false
        },
        "ocr_auto_rapidtess": {
          "ocr_enabled": true,
          "ocr_mode": "auto",
          "ocr_engine": "rapidtess",
          "ocr_language": "por",
          "ocr_dpi": 150,
          "layout_module": true,
          "parser_header": true,
          "parser_footer": true,
          "force_text": true,
          "write_images": false,
          "embed_images": false,
          "page_separators": false
        },
        "ocr_force_rapidtess": {
          "ocr_enabled": true,
          "ocr_mode": "forced",
          "ocr_engine": "rapidtess",
          "ocr_language": "por",
          "ocr_dpi": 300,
          "layout_module": true,
          "parser_header": true,
          "parser_footer": true,
          "force_text": true,
          "write_images": false,
          "embed_images": false,
          "page_separators": false
        },
        "ocr_auto_rapidtess_150": {
          "ocr_enabled": true,
          "ocr_mode": "auto",
          "ocr_engine": "rapidtess",
          "ocr_language": "por",
          "ocr_dpi": 150,
          "layout_module": true,
          "parser_header": true,
          "parser_footer": true,
          "force_text": true,
          "write_images": false,
          "embed_images": false,
          "page_separators": false
        },
        "ocr_auto_rapidtess_200": {
          "ocr_enabled": true,
          "ocr_mode": "auto",
          "ocr_engine": "rapidtess",
          "ocr_language": "por",
          "ocr_dpi": 200,
          "layout_module": true,
          "parser_header": true,
          "parser_footer": true,
          "force_text": true,
          "write_images": false,
          "embed_images": false,
          "page_separators": false
        },
        "ocr_auto_rapidtess_300": {
          "ocr_enabled": true,
          "ocr_mode": "auto",
          "ocr_engine": "rapidtess",
          "ocr_language": "por",
          "ocr_dpi": 300,
          "layout_module": true,
          "parser_header": true,
          "parser_footer": true,
          "force_text": true,
          "write_images": false,
          "embed_images": false,
          "page_separators": false
        }
      }
    },
    "docling": {
      "profiles": {
        "native": {
          "ocr_enabled": false,
          "ocr_mode": "disabled",
          "ocr_engine": null,
          "ocr_backend": null,
          "ocr_language": null,
          "ocr_scale": null,
          "table_structure": true,
          "table_mode": "accurate",
          "table_cell_matching": true,
          "picture_description": false,
          "picture_classification": false,
          "chart_extraction": false,
          "formula_enrichment": false,
          "code_enrichment": false,
          "generate_picture_images": false,
          "images_scale": 1.0,
          "remote_services_enabled": false,
          "accelerator_device": "cpu",
          "threads": 2,
          "model_artifacts_path": "/home/appuser/.cache/docling/models"
        },
        "ocr_auto": {
          "ocr_enabled": true,
          "ocr_mode": "pdf_aware_layout_regions",
          "ocr_engine": "rapidocr",
          "ocr_backend": "torch",
          "ocr_language": "pt",
          "ocr_scale": 3.0,
          "table_structure": true,
          "table_mode": "accurate",
          "table_cell_matching": true,
          "picture_description": false,
          "picture_classification": false,
          "chart_extraction": false,
          "formula_enrichment": false,
          "code_enrichment": false,
          "generate_picture_images": false,
          "images_scale": 1.0,
          "remote_services_enabled": false,
          "accelerator_device": "cpu",
          "threads": 2,
          "model_artifacts_path": "/home/appuser/.cache/docling/models"
        },
        "ocr_auto_visual": {
          "ocr_enabled": true,
          "ocr_mode": "pdf_aware_layout_regions",
          "table_structure": true,
          "picture_description": true,
          "picture_description_preset": "smolvlm",
          "picture_description_prompt": "Describe the image concisely and factually. Include visible text, labels, quantities, relationships, and chart trends when present. Do not speculate.",
          "picture_area_threshold": 0.0,
          "generate_picture_images": true,
          "images_scale": 2.0,
          "remote_services_enabled": false,
          "ocr_engine": "rapidocr",
          "ocr_backend": "torch",
          "ocr_language": "pt",
          "ocr_scale": 3.0,
          "table_mode": "accurate",
          "table_cell_matching": true,
          "picture_classification": false,
          "chart_extraction": false,
          "formula_enrichment": false,
          "code_enrichment": false,
          "accelerator_device": "cpu",
          "threads": 2,
          "model_artifacts_path": "/home/appuser/.cache/docling/models"
        },
        "ocr_auto_formula": {
          "ocr_enabled": true,
          "ocr_mode": "pdf_aware_layout_regions",
          "ocr_engine": "rapidocr",
          "ocr_backend": "torch",
          "ocr_language": "pt",
          "ocr_scale": 3.0,
          "table_structure": true,
          "table_mode": "accurate",
          "table_cell_matching": true,
          "picture_description": false,
          "picture_classification": false,
          "chart_extraction": false,
          "formula_enrichment": true,
          "code_enrichment": false,
          "generate_picture_images": false,
          "images_scale": 1.0,
          "remote_services_enabled": false,
          "accelerator_device": "cpu",
          "threads": 2,
          "model_artifacts_path": "/home/appuser/.cache/docling/models"
        },
        "ocr_auto_picture_classification": {
          "ocr_enabled": true,
          "ocr_mode": "pdf_aware_layout_regions",
          "ocr_engine": "rapidocr",
          "ocr_backend": "torch",
          "ocr_language": "pt",
          "ocr_scale": 3.0,
          "table_structure": true,
          "table_mode": "accurate",
          "table_cell_matching": true,
          "picture_description": false,
          "picture_classification": true,
          "chart_extraction": false,
          "formula_enrichment": false,
          "code_enrichment": false,
          "generate_picture_images": false,
          "images_scale": 1.0,
          "remote_services_enabled": false,
          "accelerator_device": "cpu",
          "threads": 2,
          "model_artifacts_path": "/home/appuser/.cache/docling/models"
        }
